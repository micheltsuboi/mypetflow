        "jsCode": "const pet = $json.petName || 'seu pet';\nconst service = $json.serviceName || 'serviço';\nconst date = $json.formattedDate || '';\nconst time = $json.formattedTime || '';\nconst phone = ($json.tutorPhone || '').replace(/\\D/g, '');\nconst phone55 = phone.startsWith('55') ? phone : '55' + phone;\nreturn [{\n  json: {\n    phone: phone55,\n    message: `🔄 *Horário Reagendado!*\\n\\nOlá! Passando para avisar que o horário do *${pet}* para *${service}* foi atualizado.\\n\\n📆 Nova Data: *${date}* às *${time}*\\n\\nQualquer dúvida, estamos à disposição! 🐶`\n  }\n}];"
      },
