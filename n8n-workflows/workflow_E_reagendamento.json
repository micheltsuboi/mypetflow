{
  "name": "🐾 Pet Flow - Agendamento Reagendado",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "pet-reagendamento",
        "options": {},
        "responseMode": "onReceived"
      },
      "id": "webhook-reagendamento",
      "name": "Webhook - Reagendamento",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [
        240,
        300
      ],
      "webhookId": "pet-reagendamento"
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst body = (input.body && input.body.body) ? input.body.body : (input.body || input);\nconst pet = body.petName || 'seu pet';\nconst service = body.serviceName || 'serviço';\nconst date = body.formattedDate || '';\nconst time = body.formattedTime || '';\nconst phone = (body.tutorPhone || '').replace(/\\D/g, '');\nconst phone55 = phone.startsWith('55') ? phone : '55' + phone;\nreturn [{\n  json: {\n    phone: phone55,\n    message: `🔄 *Horário Reagendado!*\\n\\nOlá! Passando para avisar que o horário do *${pet}* para *${service}* foi atualizado.\\n\\n📆 Nova Data: *${date}* às *${time}*\\n\\nQualquer dúvida, estamos à disposição! 🐶`,\n    wa_integration_type: body.wa_integration_type || 'system',\n    wa_api_url: body.wa_api_url || '',\n    wa_api_token: body.wa_api_token || '',\n    wa_client_token: body.wa_client_token || ''\n  }\n}];"
      },
      "id": "msg-reagendamento",
      "name": "Montar Mensagem",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.wa_integration_type === 'custom' && $json.wa_api_url ? ($json.wa_api_url.toLowerCase().includes('/token/') ? $json.wa_api_url.replace(/\\/$/, '') + '/send-text' : $json.wa_api_url.replace(/\\/$/, '') + '/token/' + $json.wa_api_token + '/send-text') : 'https://api.z-api.io/instances/3F245682DF48F0823F789694814B07C7/token/7880A683DDA466109EACD383/send-text' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Client-Token",
              "value": "={{ $json.wa_integration_type === 'custom' && $json.wa_client_token ? $json.wa_client_token : 'F9a70c76e1ddd4ec79ff35af7549a478fS' }}"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "phone",
              "value": "={{ $json.phone }}"
            },
            {
              "name": "message",
              "value": "={{ $json.message }}"
            }
          ]
        },
        "options": {}
      },
      "id": "zapi-reagendamento",
      "name": "Z-API: Enviar Reagendamento",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        760,
        300
      ]
    }
  ],
