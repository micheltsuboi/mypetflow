              "value": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im91ZGVmeHBva3hwZnpxa2Vod216Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3NjY4MjQ3NjAsImV4cCI6MjA4MjQwMDc2MH0.i5u_fa2q8GxkibeApRia4EELLfMFAv7-yR_K5xLhRBU"
            },
            {
              "name": "Authorization",
              "value": "Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im91ZGVmeHBva3hwZnpxa2Vod216Iiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc2NjgyNDc2MCwiZXhwIjoyMDgyNDAwNzYwfQ.sPkZSCWEqK93WIpKDTfw9AvNhXy6J1zZJ8xw2pXhs5Y"
            }
          ]
        },
        "method": "GET",
        "queryParameters": {
          "parameters": [
            {
              "name": "select",
              "value": "data_reforco,pet:pets!inner(nome,is_deceased),tutor:tutores(nome,celular),vacina:vacinas(nome)"
            },
            {
              "name": "data_reforco",
              "value": "=eq.{{ $now.toFormat('yyyy-MM-dd') }}"
            },
            {
              "name": "pet.is_deceased",
              "value": "neq.true"
            }
          ]
        },
        "sendHeaders": true,
        "sendQuery": true,
        "url": "https://oudefxpokxpfzqkehwmz.supabase.co/rest/v1/protocolo_vacinal"
      },
