        300,
        200
      ],
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1
    },
    {
      "id": "code_id",
      "name": "Code",
      "parameters": {
        "jsCode": "const results = [];\nfor (const item of $input.all()) {\n  const data = item.json;\n  if (!data.tutor || !data.tutor.celular) continue;\n  const phone = data.tutor.celular.replace(/\\D/g, '');\n  const fullPhone = phone.startsWith('55') ? phone : '55' + phone;\n  const [y, m, d] = data.data_reforco.split('-');\n  const dataVenc = `${d}/${m}/${y}`;\n  const message = `Olá, ${data.tutor.nome}! 🐾\nAqui é a Dra. Bruna Yumi.\n\nPassando para avisar que a vacina ${data.vacina?.nome || 'não informada'} do(a) ${data.pet?.nome || 'seu pet'} está vencendo hoje (dia ${dataVenc}). Manter a imunização em dia é o maior ato de cuidado com ele(a)! \n\nVamos agendar um horário para garantir essa proteção? 😊`;\n  results.push({ json: { phone: fullPhone, message: message } });\n}\nreturn results;"
      },
      "position": [
        500,
        200
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
    {
      "id": "zapi_id",
      "name": "Z-API Send",
      "parameters": {
        "bodyParameters": {
          "parameters": [
            {
              "name": "phone",
              "value": "={{ $json.phone }}"
            },
            {
              "name": "message",
              "value": "={{ $json.message }}"
            }
          ]
        },
        "method": "POST",
        "sendBody": true,
        "url": "https://api.z-api.io/instances/3F310C46CF234376AF8B627FC12A737B/token/13B3DEF046E73033F8FC74C7/send-text"
      },
      "position": [
        700,
        200
      ],
