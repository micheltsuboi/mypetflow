              "name": "phone",
              "value": "={{ ($json.customers?.phone_1 || '').replace(/\\D/g, '').startsWith('55') ? ($json.customers?.phone_1 || '').replace(/\\D/g, '') : '55' + ($json.customers?.phone_1 || '').replace(/\\D/g, '') }}"
